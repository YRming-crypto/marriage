# Copy to a private .env.deploy file in the repository root. Never commit it.
COMPOSE_PROJECT_NAME=ai-marriage
APP_HTTP_PORT=8080

# External HTTPS origin used by browsers and the API CORS allow-list.
PUBLIC_ORIGIN=https://marriage.example.com
# CIDR of the external TLS reverse proxy that is allowed to provide
# X-Forwarded-For. Use 127.0.0.1/32 only when clients connect directly.
TRUSTED_PROXY_CIDR=127.0.0.1/32

POSTGRES_DB=ai_marriage
POSTGRES_USER=ai_marriage
POSTGRES_PASSWORD=
# Use the Docker service hostname "postgres". URL-encode special characters in
# the password, while POSTGRES_PASSWORD above keeps the original password.
DATABASE_URL=

# Generate a unique random value of at least 32 characters. Do not rotate it
# without re-encrypting the application's encrypted database fields.
APP_ENCRYPTION_KEY=
ADMIN_PHONES=
# Required whenever ADMIN_PHONES is set. Keep it in a secret manager.
ADMIN_ACCESS_CODE=
OTP_TTL_SECONDS=300
TRUST_PROXY=true

# Production SMS delivery. The endpoint receives a JSON POST containing
# phone, code and expiresInSeconds. Put provider credentials in a secret manager.
SMS_PROVIDER=http
SMS_WEBHOOK_URL=
SMS_BEARER_TOKEN=

# S3-compatible photo storage. S3_PUBLIC_BASE_URL is the browser-accessible
# HTTPS base used for approved profile photos.
OBJECT_STORAGE_PROVIDER=s3
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=true

# OpenAI-compatible chat-completions endpoint used by authorized AI avatars.
AVATAR_MODEL_PROVIDER=openai
AVATAR_MODEL_ENDPOINT=
AVATAR_MODEL_API_KEY=
AVATAR_MODEL_NAME=
