{
  "name": "@ai-marriage/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build --workspace @ai-marriage/shared",
    "dev": "vite --host 127.0.0.1 --port 4185",
