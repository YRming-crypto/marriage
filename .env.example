# Host development example. Production Compose uses deploy/.env.example.
WEB_PORT=4183
API_PORT=4184
VITE_API_URL=http://127.0.0.1:4184

# Local PostgreSQL used by Prisma when the API runs on the host machine.
POSTGRES_PORT=5432
POSTGRES_DB=ai_marriage
POSTGRES_USER=ai_marriage
POSTGRES_PASSWORD=ai_marriage_dev_password
DATABASE_URL=postgresql://ai_marriage:ai_marriage_dev_password@127.0.0.1:5432/ai_marriage
# Set to true only for a disposable local run that must ignore DATABASE_URL.
USE_IN_MEMORY_STORE=false

# Local S3-compatible object storage. MinIO is only required by photo upload flows.
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev_password
MINIO_BUCKET=ai-marriage-local
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_dev_password
S3_BUCKET=ai-marriage-local
S3_PUBLIC_BASE_URL=http://127.0.0.1:9000/ai-marriage-local
S3_FORCE_PATH_STYLE=true

# Provider switches. These defaults keep local development self-contained.
SMS_PROVIDER=console
OBJECT_STORAGE_PROVIDER=s3
AVATAR_MODEL_PROVIDER=deterministic

# Set these when exercising real provider integrations locally.
SMS_WEBHOOK_URL=
SMS_BEARER_TOKEN=
AVATAR_MODEL_ENDPOINT=
AVATAR_MODEL_API_KEY=
AVATAR_MODEL_NAME=

# Development-only OTP settings. Never use a fixed OTP in production.
NODE_ENV=development
DEV_OTP_CODE=123456
OTP_TTL_SECONDS=300
# Separate from the login OTP. Required before admin and moderator actions.
ADMIN_ACCESS_CODE=654321
COOKIE_SECURE=false
TRUST_PROXY=false

# Used to encrypt phone numbers and private chat content at rest.
# Replace this value before any shared or production deployment.
APP_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Required in production. Multiple origins are separated with commas.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:4183,http://localhost:4183
